# Apuntar al registro oficial y moderno de paquetes de Autodesk Platform Services (APS)
@autodesk:registry=https://developer.api.autodesk.com/autodesk-forge/v1/npm/

# La siguiente línea puede que ya no sea necesaria con la URL correcta,
# pero la mantenemos como medida de seguridad.
@autodesk:strict-ssl=false
